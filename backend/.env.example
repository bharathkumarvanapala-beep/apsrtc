# APSRTC SmartTrack Server Environment
PORT=5000
NODE_ENV=development
DB_CLIENT=sqlite
DB_PATH=./apsrtc.db
CORS_ORIGIN=*
DEMO_MODE=true

# Freshness Thresholds (Seconds)
FRESHNESS_LIVE_SEC=10
FRESHNESS_RECENT_SEC=60
FRESHNESS_STALE_SEC=300

# Future PostgreSQL Deployment (when DB_CLIENT=postgres)
# PG_HOST=localhost
# PG_PORT=5432
# PG_USER=apsrtc_admin
# PG_PASSWORD=secure_password_here
# PG_DATABASE=apsrtc_smarttrack
